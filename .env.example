# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Model overrides (optional — defaults to gpt-4o-mini) ─────────────────────
# WIZARD_CRAWL_LINK_MODEL=gpt-4o-mini
# WIZARD_CRAWL_EXTRACT_MODEL=gpt-4o-mini
# WIZARD_CRAWL_VALIDATE_MODEL=gpt-4o-mini
# WIZARD_CRAWL_CATALOG_MODEL=gpt-4o-mini

# ─── Test UI ───────────────────────────────────────────────────────────────────
PORT=5001

# ─── ScraperAPI (for sites with Kasada/Akamai bot protection) ─────────────────
# Sign up at: https://www.scraperapi.com/
SCRAPERAPI_KEY=your_scraperapi_key_here

# ─── ZenRows (alternative to ScraperAPI — explicit Kasada support) ────────────
# Sign up at: https://www.zenrows.com/
# ZENROWS_KEY=your_zenrows_key_here
